{
  "name": "drizzle-uncache",
  "version": "2.0.0",
  "description": "Cache adapter for Drizzle ORM v1 powered by unstorage",
  "license": "MIT",
  "author": "dschewchenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dschewchenko/drizzle-uncache.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "check": "bun run format:check && bun run lint",
    "check:fix": "bun run format && oxlint . --fix",
    "dev": "bunx vitest",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint . --report-unused-disable-directives",
    "playground": "bun playground/redis.ts",
    "prepack": "bun run build",
    "release": "semantic-release",
    "test": "bun run check && bun run test:types && bunx vitest run",
    "test:types": "bunx tsc --noEmit --pretty false"
  },
  "devDependencies": {
    "@nkzw/oxlint-config": "3.0.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "12.0.11",
    "@semantic-release/npm": "13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/bun": "1.4.5",
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "4.1.12",
    "drizzle-orm": "1.0.0-rc.3",
    "elysia": "1.4.32",
    "file-type": "22.3.0",
    "ioredis": "^5.11.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "semantic-release": "25.0.9",
    "tsdown": "0.23.7",
    "tsrs": "7.1.0-beta.tsrs4",
    "typescript": "7.0.2",
    "unstorage": "^1.17.5",
    "vitest": "4.1.12"
  },
  "peerDependencies": {
    "drizzle-orm": "^1.0.0-rc.3",
    "unstorage": "^1.17.5"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "npm": "11.21.3"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=22"
  },
  "packageManager": "bun@1.4.5"
}
